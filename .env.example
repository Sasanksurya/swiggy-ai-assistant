# Copy to .env for local development. Never commit .env.
APP_ENV=development
# true = synthetic Mock Swiggy MCP, false = authorized Swiggy MCP (Stage 2, not implemented yet)
MOCK_MODE=true
MOCK_MCP_URL=http://mock-mcp:8100

POSTGRES_USER=swiggy
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=swiggy_assistant
DATABASE_URL=postgresql://swiggy:change-me-locally@postgres:5432/swiggy_assistant
REDIS_URL=redis://redis:6379/0

CORS_ORIGINS=["http://localhost:3000"]

# Assistant (Phase 2)
SESSION_STORE=memory            # memory | redis (docker-compose sets redis)
SESSION_TTL_SECONDS=3600
NLU_PROVIDER=rules              # rules (free, offline) | ollama (rules first, LLM only for unknown messages)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

ASSISTANT_NAME=Sarah

# Observability: LangSmith tracing (optional, free tier at https://smith.langchain.com)
# Put your real key ONLY in .env (never in .env.example or Git).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=swiggy-ai-assistant

# Real Swiggy (Builders Club, invite-based: https://mcp.swiggy.com/builders/access/)
# Leave MOCK_MODE=true until you have connected an account. Orders stay off unless ALLOW_REAL_ORDERS=true.
ALLOW_REAL_ORDERS=false
SWIGGY_BASE_URL=https://mcp.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:8000/api/swiggy/callback
SWIGGY_TOKEN_PATH=.swiggy_tokens.json
SWIGGY_CONNECT_ENABLED=true
